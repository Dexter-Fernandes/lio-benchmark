# Copy to .env and adjust. .env is gitignored; never commit credentials.

# Host directory holding the Hilti-Oxford 2022 files (layout: rosbags/, rosbag2/, ground_truth/, calibration/).
LIO_DATA_ROOT=/home/dexter/data/hilti22

# Where run records are written. Defaults to ./runs (gitignored) when unset.
LIO_RUNS_ROOT=

# Weights & Biases. Online by default: `lio-bench log <run_dir>` needs `wandb login` (an
# API key from wandb.ai/authorize) to push runs to the dashboard. Set WANDB_MODE=offline to
# develop without credentials; sync later with `wandb sync runs/<run_id>/wandb/offline-run-*`.
WANDB_MODE=online
WANDB_ENTITY=
WANDB_PROJECT=lio-benchmark
